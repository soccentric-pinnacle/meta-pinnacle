# boot.cmd — A/B OTA rollback for NXP i.MX 93 (Pinnacle)
#
# Compiled to boot.scr by mkimage via UBOOT_ENV/UBOOT_ENV_SUFFIX=scr in
# kas/common.yaml. The boot partition (p1, FAT) carries imx-boot, Image,
# the DTB and an extlinux.conf (generated by bootimg-partition). We use
# sysboot to load extlinux.conf, which points root= at the active slot's
# PARTUUID.
#
# Bootcount flow (same scheme as the other SiliconCentric platforms):
#   1. First boot: uboot.env absent on p1 -> saveenv canonical defaults
#      (bootlimit=3, altbootcmd toggles upgrade_available and zeroes
#      bootcount, upgrade_available=0, bootcount=0).
#   2. If upgrade_available=1, increment bootcount and saveenv. If
#      bootcount >= bootlimit, run altbootcmd (clears upgrade_available,
#      zeroes bootcount) -> rolls back to the previous slot.
#   3. On a healthy boot, swupdate-bootcheck.service triggers
#      bootcount-reset.service, which sets upgrade_available=0.
#
# This is a U-Boot Hush script (NOT bash).

# First-ever boot: initialise the env.
if test ! -e mmc 0:1 uboot.env; then
    setenv bootlimit 3
    setenv altbootcmd "setenv upgrade_available 0; setenv bootcount 0; run bootcmd"
    setenv upgrade_available 0
    setenv bootcount 0
    saveenv
fi

# If an update is pending, tick the bootcount and trip altbootcmd when we
# exceed bootlimit.
if test "${upgrade_available}" = "1"; then
    setexpr.b bootcount ${bootcount} + 1
    saveenv
    if test ${bootcount} -ge ${bootlimit}; then
        echo "bootcount ${bootcount} >= ${bootlimit}, running altbootcmd"
        run altbootcmd
    fi
fi

# Load and run the extlinux config from the boot partition (p1).
sysboot mmc 0:1 any ${scriptaddr} /extlinux/extlinux.conf
