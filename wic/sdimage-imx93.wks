# i.MX 93 FRDM SD card image — A/B OTA layout
#
# Disk layout:
#  - --------- ---------- ---------- ----------
# | | imx-boot |  /boot   | rootfs-a | rootfs-b |
#  - --------- ---------- ---------- ----------
# ^ ^          ^          ^          ^
# | |          |          |          |
# 0 32kiB    8MiB       264MiB   264MiB + rootfs-a + rootfs-b
#
# imx-boot is placed at 32kiB (IMX_BOOT_SEEK) without a partition table entry.
# /boot  (p1) holds kernel image, DTBs, and U-Boot scripts.
# rootfs-a (p2) is the active root filesystem (A slot, populated at build time).
# rootfs-b (p3) is the standby root filesystem (B slot, written by SWUpdate).
#
# SWUpdate writes the new rootfs to the inactive slot and updates the U-Boot
# environment (mmcpart) so the next boot uses the updated slot.

part u-boot --source rawcopy --sourceparams="file=imx-boot.tagged" --ondisk mmcblk --no-table --align 32

part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 8192 --fixed-size 256M

part / --source rootfs --ondisk mmcblk --fstype=ext4 --label rootfs-a --align 8192 --fixed-size 8192M

part --source empty --ondisk mmcblk --fstype=ext4 --label rootfs-b --align 8192 --fixed-size 8192M

bootloader --ptable msdos
